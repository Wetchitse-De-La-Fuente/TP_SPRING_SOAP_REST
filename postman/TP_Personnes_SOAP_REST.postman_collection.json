            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Bon identifiant\", function () {",
              "    pm.expect(pm.response.json().id.toString()).to.eql(pm.collectionVariables.get(\"personneId\").toString());",
              "});"
            ]
