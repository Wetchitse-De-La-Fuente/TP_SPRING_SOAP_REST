    {
      "name": "01 - POST creer (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/personnes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "personnes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Diop\",\n  \"prenom\": \"Aminata\",\n  \"age\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"Identifiant auto-généré\", function () {",
              "    pm.expect(body.id).to.be.a(\"number\");",
              "});",
              "pm.collectionVariables.set(\"personneId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET par id (200)",
      "request": {
