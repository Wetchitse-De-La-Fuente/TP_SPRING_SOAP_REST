    {
      "name": "08 - SOAP direct / getAllPersonnes",
      "request": {
        "method": "POST",
        "url": {
          "raw": "http://localhost:8081/ws",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "ws"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml;charset=UTF-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:per=\"http://tp.sn/personnes\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <per:getAllPersonnesRequest/>\n   </soapenv:Body>\n</soapenv:Envelope>\n",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SOAP HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Reponse SOAP\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"getAllPersonnesResponse\");",
              "});"
            ]
          }
        }
      ]
