<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://tp.sn/personnes" targetNamespace="http://tp.sn/personnes" elementFormDefault="qualified">
  <xs:complexType name="personneType">
    <xs:sequence>
      <xs:element name="id" type="xs:long"/>
      <xs:element name="nom" type="xs:string"/>
      <xs:element name="prenom" type="xs:string"/>
      <xs:element name="age" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="addPersonneRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="nom" type="xs:string"/>
        <xs:element name="prenom" type="xs:string"/>
        <xs:element name="age" type="xs:int"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="addPersonneResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="personne" type="tns:personneType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="getPersonneRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:long"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="getPersonneResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="personne" type="tns:personneType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="getAllPersonnesRequest">
    <xs:complexType>
      <xs:sequence/>
    </xs:complexType>
  </xs:element>
  <xs:element name="getAllPersonnesResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="personne" type="tns:personneType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="updatePersonneRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:long"/>
        <xs:element name="nom" type="xs:string"/>
        <xs:element name="prenom" type="xs:string"/>
        <xs:element name="age" type="xs:int"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="updatePersonneResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="personne" type="tns:personneType" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="deletePersonneRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:long"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="deletePersonneResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="deleted" type="xs:boolean"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
